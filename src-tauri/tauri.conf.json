{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atak Redis Desktop Manager",
  "mainBinaryName": "atak-redis-desktop-manager",
  "version": "0.1.0",
  "identifier": "com.atakdomain.redisdesktopmanager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atak Redis Desktop Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Redis masaüstü yöneticisi",
    "longDescription": "Hızlı, çapraz platform Redis masaüstü yöneticisi: toplu işlemler, büyük/küçük harf duyarlı arama, SSH/TLS/Cluster/Sentinel ve Another Redis Desktop Manager'dan tek tıkla aktarım.",
    "publisher": "Atak Domain",
    "copyright": "© 2026 Atak Domain",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "devel" }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
